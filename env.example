# Copy to .env and change values. Never commit .env
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me
# Port on your machine for DBeaver/psql (container still uses 5432 internally)
POSTGRES_HOST_PORT=5433
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
# Linux only: set to output of `id -u` so Airflow can write ./logs and ./data
AIRFLOW_UID=50000
# Which sources to run (comma separated): seed,b2s,amarin,naiin
ENABLED_SOURCES=seed,b2s,amarin
# Optional: override category URLs ({page} = page number), comma separated
# SOURCE_BOOKCAZE_URLS=
# SOURCE_B2S_URLS=
# SOURCE_AMARIN_URLS=
# B2S public *guest* token (from the site's own requests: DevTools > Network > CatalogProducts > Authorization: Bearer ...)
B2S_API_TOKEN=
# Quality gate
MIN_VALID_RATIO=0.8
MIN_TOTAL_ROWS=1
